// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  type      String   // "MERCHANT" or "STUDENT"
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  phoneNumber    String
  country        String
  kycStatus      String
  role           String            @default("USER")
  supabaseUserId String?           @unique
  createdAt      DateTime          @default(now())

  wallets        Wallet[]
  transactions   Transaction[]
  references     PaymentReference[]
  cards          VirtualCard[]

  @@map("users")
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String
  walletType String   // mpesa, mpesa_tanzania, tigo_pesa, vodacom_mpesa, airtel, mtn, ecocash, telecel, zamtel, halopesa, paystack, flutterwave, opay, palmpay, orange_money, wave, moov_money, africas_talking
  currency   String
  balance    Float
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  currency  String
  status    String
  type      String
  reference String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  entryType     String
  amount        Float
  currency      String
  createdAt     DateTime @default(now())

  @@map("ledger_entries")
}

model PaymentReference {
  id            String   @id @default(uuid())
  title         String
  institution   String
  referenceCode String   @unique
  userId        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("payment_references")
}

model WebhookEvent {
  id            String   @id @default(uuid())
  provider      String
  eventType     String
  payload       String
  status        String
  errorMessage  String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  @@map("webhook_events")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String  @unique
  method         String
  path           String
  statusCode     Int
  responseBody   String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([idempotencyKey, method, path])
  @@map("idempotency_records")
}

model ApiKey {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  userId       String?
  permissions  String[]
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@map("api_keys")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId     String?
  action      String
  resource    String
  resourceId  String?
  details     String?
  ipAddress   String?
  userAgent   String?
  requestId   String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AsyncTask {
  id           String   @id @default(uuid())
  type         String
  status       String   @default("PENDING")
  payload      String
  result       String?
  error        String?
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  scheduledAt  DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([status, scheduledAt])
  @@map("async_tasks")
}

model VirtualCard {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  cardNumber      String   @unique
  cardToken       String   @unique
  lastFourDigits  String
  expiryMonth     String
  expiryYear      String
  cvv             String
  status          String   @default("ACTIVE")
  currency        String   @default("USD")
  balance         Float    @default(0)
  limit           Float?
  isVirtual       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("virtual_cards")
}

// ============================================
// ROUTING NETWORK MODELS
// ============================================

model PaymentProvider {
  id                  String   @id @default(uuid())
  name                String   @unique // mpesa, flutterwave, paystack, etc.
  displayName         String
  region              String   // east-africa, west-africa, southern-africa, pan-african
  supportedCountries  String[] // ["KE", "NG", "GH", etc.]
  supportedCurrencies String[] // ["KES", "NGN", "USD", etc.]
  isActive            Boolean  @default(true)
  isPrimary           Boolean  @default(false)
  priority            Int      @default(0) // Lower = higher priority
  
  // Fee configuration
  feeType             String   @default("percentage") // percentage, fixed, tiered
  feePercentage       Float    @default(0)
  feeFixed            Float    @default(0)
  feeMinimum          Float    @default(0)
  feeMaximum          Float?
  
  // Limits
  minTransactionAmount Float   @default(0)
  maxTransactionAmount Float   @default(1000000)
  dailyLimit          Float?
  
  // Performance metrics (updated periodically)
  successRate         Float    @default(100)
  avgResponseTime     Float    @default(0) // milliseconds
  uptime              Float    @default(100) // percentage
  lastHealthCheck     DateTime?
  
  // Configuration
  config              String?  // JSON config for provider-specific settings
  credentials         String?  // Encrypted credentials
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routingRules        RoutingRule[]
  transactions        RoutedTransaction[]
  healthChecks        ProviderHealthCheck[]

  @@index([region])
  @@index([isActive])
  @@index([priority])
  @@map("payment_providers")
}

model RoutingRule {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  isActive            Boolean  @default(true)
  priority            Int      @default(0) // Higher = evaluated first
  
  // Conditions
  countries           String[] // Target countries
  currencies          String[] // Target currencies
  minAmount           Float?
  maxAmount           Float?
  providerTypes       String[] // Wallet types this rule applies to
  
  // Routing strategy
  strategy            String   @default("best_rate") // best_rate, fastest, cheapest, primary_first, round_robin
  fallbackProviders   String[] // Provider IDs to try if primary fails
  maxRetries          Int      @default(2)
  
  // Time-based routing
  activeHours         String?  // JSON: {start: "00:00", end: "23:59"}
  activeDays          String[] // ["MON", "TUE", etc.]
  
  // Weights for weighted round-robin
  weights             String?  // JSON: {provider_id: weight}
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  provider            PaymentProvider? @relation(fields: [primaryProviderId], references: [id])
  primaryProviderId   String?

  @@index([isActive])
  @@index([priority])
  @@index([countries])
  @@map("routing_rules")
}

model RoutedTransaction {
  id                  String   @id @default(uuid())
  transactionId       String   // Original transaction ID
  userId              String
  
  // Routing decision
  selectedProvider    String
  selectedProviderId  String
  routingRuleId       String?
  routingReason       String   // Why this provider was selected
  
  // Attempt tracking
  attemptNumber       Int      @default(1)
  maxAttempts         Int      @default(3)
  previousProviders   String[] // Providers that failed
  
  // Transaction details
  amount              Float
  currency            String
  destinationCountry  String
  destinationProvider String?
  
  // Status
  status              String   @default("PENDING") // PENDING, ROUTED, PROCESSING, COMPLETED, FAILED, REROUTED
  providerResponse    String?  // JSON response from provider
  providerReference   String?
  providerTransactionId String?
  
  // Timing
  routedAt            DateTime @default(now())
  providerRequestedAt DateTime?
  providerRespondedAt DateTime?
  completedAt         DateTime?
  
  // Error handling
  errorCode           String?
  errorMessage        String?
  willRetry           Boolean  @default(false)
  nextRetryAt         DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  provider            PaymentProvider @relation(fields: [selectedProviderId], references: [id])

  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@index([selectedProvider])
  @@index([routedAt])
  @@map("routed_transactions")
}

model ProviderHealthCheck {
  id                  String   @id @default(uuid())
  providerId          String
  status              String   // HEALTHY, DEGRADED, UNHEALTHY, UNKNOWN
  isReachable         Boolean  @default(false)
  responseTime        Float    @default(0) // milliseconds
  
  // Test transaction results
  testSuccess         Boolean?
  testErrorMessage    String?
  
  // Metrics snapshot
  successRate         Float?
  avgResponseTime     Float?
  
  // Metadata
  checkType           String   @default("ping") // ping, test_transaction, api_call
  metadata            String?  // JSON additional data
  
  createdAt           DateTime @default(now())

  provider            PaymentProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("provider_health_checks")
}

model RoutingMetric {
  id                  String   @id @default(uuid())
  date                DateTime @db.Date
  provider            String
  country             String
  currency            String
  
  // Volume metrics
  totalTransactions   Int      @default(0)
  successfulTransactions Int   @default(0)
  failedTransactions  Int      @default(0)
  totalAmount         Float    @default(0)
  
  // Performance metrics
  avgResponseTime     Float    @default(0)
  p95ResponseTime     Float    @default(0)
  p99ResponseTime     Float    @default(0)
  
  // Cost metrics
  totalFees           Float    @default(0)
  avgFeePercentage    Float    @default(0)
  
  // Calculated success rate
  successRate         Float    @default(100)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([date, provider, country, currency])
  @@index([date])
  @@index([provider])
  @@map("routing_metrics")
}

model ExchangeRate {
  id                  String   @id @default(uuid())
  baseCurrency        String
  targetCurrency      String
  rate                Float
  inverseRate         Float
  source              String   // central_bank, provider, market
  provider            String?  // If rate is provider-specific
  
  // Validity
  isValid             Boolean  @default(true)
  validFrom           DateTime @default(now())
  validUntil          DateTime?
  
  // Spread/margin
  spread              Float    @default(0)
  margin              Float    @default(0)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency, source, provider])
  @@index([baseCurrency])
  @@index([targetCurrency])
  @@map("exchange_rates")
}

// ============================================
// P2P CROSS-BORDER TRANSFER MODELS
// ============================================

model P2PTransfer {
  id                  String   @id @default(uuid())
  transferRef         String   @unique
  userId              String   // Sender user ID
  
  // Sender details
  senderPhone         String
  senderCountry       String
  senderWalletType    String
  
  // Recipient details
  recipientPhone      String
  recipientName       String?
  recipientCountry    String
  recipientWalletType String
  
  // Amount details
  sendAmount          Float
  sendCurrency        String
  receiveAmount       Float
  receiveCurrency     String
  exchangeRate        Float
  
  // Fees
  transferFee         Float
  fxFee               Float
  totalFees           Float
  totalDebit          Float   // sendAmount + fees
  
  // Routing
  routingProvider     String
  routingProviderId   String
  providerReference   String?
  providerTransactionId String?
  
  // Status
  status              String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED
  failureReason       String?
  
  // Compliance
  kycRequired         Boolean  @default(false)
  kycStatus           String?  // PENDING, VERIFIED, REJECTED
  complianceCheck     String?  // JSON compliance data
  
  // Timing
  createdAt           DateTime @default(now())
  processedAt         DateTime?
  completedAt         DateTime?
  expiresAt           DateTime?
  
  // Metadata
  description         String?
  metadata            String?  // JSON additional data

  @@index([userId])
  @@index([transferRef])
  @@index([senderPhone])
  @@index([recipientPhone])
  @@index([status])
  @@index([createdAt])
  @@map("p2p_transfers")
}

model TransferRecipient {
  id                  String   @id @default(uuid())
  userId              String   // User who saved this recipient
  name                String
  phoneNumber         String
  country             String
  walletType          String
  isVerified          Boolean  @default(false)
  lastUsedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([phoneNumber, country])
  @@map("transfer_recipients")
}

model TransferLimit {
  id                  String   @id @default(uuid())
  country             String
  currency            String
  walletType          String
  
  // Daily limits
  dailyMin            Float    @default(0)
  dailyMax            Float    @default(10000)
  
  // Per transaction limits
  transactionMin      Float    @default(0)
  transactionMax      Float    @default(5000)
  
  // Monthly limits
  monthlyMax          Float?
  
  // KYC tiers
  kycRequired         Boolean  @default(false)
  kycTier             String?  // basic, enhanced, premium
  
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([country, currency, walletType])
  @@map("transfer_limits")
}

model ComplianceCheck {
  id                  String   @id @default(uuid())
  transferId          String?
  userId              String?
  checkType           String   // sanctions, pep, fraud, amount_threshold
  
  // Result
  status              String   // PASS, FAIL, REVIEW
  riskScore           Float    @default(0)
  riskLevel           String   // LOW, MEDIUM, HIGH
  details             String?  // JSON check details
  
  // Action taken
  action              String?  // approved, rejected, manual_review
  reviewedBy          String?
  reviewedAt          DateTime?
  
  createdAt           DateTime @default(now())

  @@index([transferId])
  @@index([userId])
  @@index([status])
  @@map("compliance_checks")
}
