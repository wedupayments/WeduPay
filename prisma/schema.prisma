generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  type      String
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  country        String
  createdAt      DateTime           @default(now())
  kycStatus      String
  phoneNumber    String
  supabaseUserId String?            @unique
  role           String             @default("USER")
  memberships    TenantMembership[]
  references     PaymentReference[]
  transactions   Transaction[]
  cards          VirtualCard[]
  wallets        Wallet[]

  @@map("users")
}

model Tenant {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      String             @default("ACTIVE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  domains     TenantDomain[]

  @@index([slug])
  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenantId  String
  domain    String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_domains")
}

model Wallet {
  id         String   @id @default(uuid())
  currency   String
  balance    Float
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String
  walletType String
  nickname   String?
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id        String   @id @default(uuid())
  amount    Float
  currency  String
  status    String
  type      String
  reference String
  createdAt DateTime @default(now())
  tenantId  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  amount        Float
  currency      String
  accountId     String
  createdAt     DateTime @default(now())
  entryType     String
  transactionId String

  @@map("ledger_entries")
}

model PaymentReference {
  id            String   @id @default(uuid())
  title         String
  institution   String
  referenceCode String   @unique
  tenantId      String?
  userId        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("payment_references")
}

model WebhookEvent {
  id           String    @id @default(uuid())
  provider     String
  eventType    String
  payload      String
  status       String
  errorMessage String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@map("webhook_events")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  method         String
  path           String
  statusCode     Int
  responseBody   String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([idempotencyKey, method, path])
  @@map("idempotency_records")
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  tenantId    String?
  userId      String?
  permissions String[]
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  requestId  String
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AsyncTask {
  id          String    @id @default(uuid())
  type        String
  status      String    @default("PENDING")
  payload     String
  result      String?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
  @@map("async_tasks")
}

model VirtualCard {
  id             String   @id @default(uuid())
  tenantId        String?
  userId         String
  provider       String
  cardNumber     String   @unique
  cardToken      String   @unique
  lastFourDigits String
  expiryMonth    String
  expiryYear     String
  cvv            String
  status         String   @default("ACTIVE")
  currency       String   @default("USD")
  balance        Float    @default(0)
  limit          Float?
  isVirtual      Boolean  @default(true)
  nickname       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("virtual_cards")
}

model PaymentProvider {
  id                   String                @id @default(uuid())
  name                 String                @unique
  displayName          String
  region               String
  supportedCountries   String[]
  supportedCurrencies  String[]
  isActive             Boolean               @default(true)
  isPrimary            Boolean               @default(false)
  priority             Int                   @default(0)
  feeType              String                @default("percentage")
  feePercentage        Float                 @default(0)
  feeFixed             Float                 @default(0)
  feeMinimum           Float                 @default(0)
  feeMaximum           Float?
  minTransactionAmount Float                 @default(0)
  maxTransactionAmount Float                 @default(1000000)
  dailyLimit           Float?
  successRate          Float                 @default(100)
  avgResponseTime      Float                 @default(0)
  uptime               Float                 @default(100)
  lastHealthCheck      DateTime?
  config               String?
  credentials          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  healthChecks         ProviderHealthCheck[]
  transactions         RoutedTransaction[]
  routingRules         RoutingRule[]

  @@index([region])
  @@index([isActive])
  @@index([priority])
  @@map("payment_providers")
}

model RoutingRule {
  id                String           @id @default(uuid())
  name              String
  description       String?
  isActive          Boolean          @default(true)
  priority          Int              @default(0)
  countries         String[]
  currencies        String[]
  minAmount         Float?
  maxAmount         Float?
  providerTypes     String[]
  strategy          String           @default("best_rate")
  fallbackProviders String[]
  maxRetries        Int              @default(2)
  activeHours       String?
  activeDays        String[]
  weights           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  primaryProviderId String?
  provider          PaymentProvider? @relation(fields: [primaryProviderId], references: [id])

  @@index([isActive])
  @@index([priority])
  @@index([countries])
  @@map("routing_rules")
}

model RoutedTransaction {
  id                    String          @id @default(uuid())
  transactionId         String
  tenantId              String?
  userId                String
  selectedProvider      String
  selectedProviderId    String
  routingRuleId         String?
  routingReason         String
  attemptNumber         Int             @default(1)
  maxAttempts           Int             @default(3)
  previousProviders     String[]
  amount                Float
  currency              String
  destinationCountry    String
  destinationProvider   String?
  status                String          @default("PENDING")
  providerResponse      String?
  providerReference     String?
  providerTransactionId String?
  routedAt              DateTime        @default(now())
  providerRequestedAt   DateTime?
  providerRespondedAt   DateTime?
  completedAt           DateTime?
  errorCode             String?
  errorMessage          String?
  willRetry             Boolean         @default(false)
  nextRetryAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  provider              PaymentProvider @relation(fields: [selectedProviderId], references: [id])

  @@index([tenantId])
  @@index([transactionId])
  @@index([userId])
  @@index([status])
  @@index([selectedProvider])
  @@index([routedAt])
  @@map("routed_transactions")
}

model ProviderHealthCheck {
  id               String          @id @default(uuid())
  providerId       String
  status           String
  isReachable      Boolean         @default(false)
  responseTime     Float           @default(0)
  testSuccess      Boolean?
  testErrorMessage String?
  successRate      Float?
  avgResponseTime  Float?
  checkType        String          @default("ping")
  metadata         String?
  createdAt        DateTime        @default(now())
  provider         PaymentProvider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("provider_health_checks")
}

model RoutingMetric {
  id                     String   @id @default(uuid())
  date                   DateTime @db.Date
  provider               String
  country                String
  currency               String
  totalTransactions      Int      @default(0)
  successfulTransactions Int      @default(0)
  failedTransactions     Int      @default(0)
  totalAmount            Float    @default(0)
  avgResponseTime        Float    @default(0)
  p95ResponseTime        Float    @default(0)
  p99ResponseTime        Float    @default(0)
  totalFees              Float    @default(0)
  avgFeePercentage       Float    @default(0)
  successRate            Float    @default(100)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([date, provider, country, currency])
  @@index([date])
  @@index([provider])
  @@map("routing_metrics")
}

model ExchangeRate {
  id             String    @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Float
  inverseRate    Float
  source         String
  provider       String?
  isValid        Boolean   @default(true)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  spread         Float     @default(0)
  margin         Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([baseCurrency, targetCurrency, source, provider])
  @@index([baseCurrency])
  @@index([targetCurrency])
  @@map("exchange_rates")
}

model P2PTransfer {
  id                    String    @id @default(uuid())
  transferRef           String    @unique
  tenantId              String?
  userId                String
  senderPhone           String
  senderCountry         String
  senderWalletType      String
  recipientPhone        String
  recipientName         String?
  recipientCountry      String
  recipientWalletType   String
  sendAmount            Float
  sendCurrency          String
  receiveAmount         Float
  receiveCurrency       String
  exchangeRate          Float
  transferFee           Float
  fxFee                 Float
  totalFees             Float
  totalDebit            Float
  routingProvider       String
  routingProviderId     String
  providerReference     String?
  providerTransactionId String?
  status                String    @default("PENDING")
  failureReason         String?
  kycRequired           Boolean   @default(false)
  kycStatus             String?
  complianceCheck       String?
  createdAt             DateTime  @default(now())
  processedAt           DateTime?
  completedAt           DateTime?
  expiresAt             DateTime?
  description           String?
  metadata              String?

  @@index([tenantId])
  @@index([userId])
  @@index([transferRef])
  @@index([senderPhone])
  @@index([recipientPhone])
  @@index([status])
  @@index([createdAt])
  @@map("p2p_transfers")
}

model TransferRecipient {
  id          String    @id @default(uuid())
  tenantId     String?
  userId      String
  name        String
  phoneNumber String
  country     String
  walletType  String
  isVerified  Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([phoneNumber, country])
  @@map("transfer_recipients")
}

model TransferLimit {
  id             String   @id @default(uuid())
  country        String
  currency       String
  walletType     String
  dailyMin       Float    @default(0)
  dailyMax       Float    @default(10000)
  transactionMin Float    @default(0)
  transactionMax Float    @default(5000)
  monthlyMax     Float?
  kycRequired    Boolean  @default(false)
  kycTier        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([country, currency, walletType])
  @@map("transfer_limits")
}

model ComplianceCheck {
  id         String    @id @default(uuid())
  transferId String?
  tenantId   String?
  userId     String?
  checkType  String
  status     String
  riskScore  Float     @default(0)
  riskLevel  String
  details    String?
  action     String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([transferId])
  @@index([userId])
  @@index([status])
  @@map("compliance_checks")
}
